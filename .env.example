# Copy this file to .env and fill in real values.
# Do not commit real passwords, tokens, or API keys.

# Email alert settings.
VCD_EMAIL_ADDRESS=your-gmail-address@gmail.com
VCD_EMAIL_APP_PASSWORD=your-gmail-app-password
VCD_HOSPITAL_EMAIL=hospital@example.com
VCD_POLICE_EMAIL=police@example.com
VCD_RTO_EMAIL=rto@example.com

# SMS option 1: Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_TO_NUMBERS=
TWILIO_DEFAULT_COUNTRY_CODE=+91
TWILIO_SMS_MODE=trial-safe

# SMS option 2: FAST2SMS.
FAST2SMS_API_KEY=
FAST2SMS_NUMBERS=
FAST2SMS_ROUTE=q
